# ---------------------------------------------------------------------------
# PayMinute configuration. Copy to .env and fill in. Never commit your real .env.
# ---------------------------------------------------------------------------

# PayPal sandbox app "PayMinute" (developer.paypal.com → Apps & Credentials → Sandbox → PayMinute)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app page after you add a webhook (see docs/SANDBOX_SETUP.md)
PAYPAL_WEBHOOK_ID=

# Log in with PayPal (enable it on the same sandbox app; Return URL = APP_BASE_URL + /api/auth/callback)
AUTH_REQUIRED=true
# Long random string that signs the login cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# log out after this many minutes without activity (0 = never); sessions also end after SESSION_HOURS
SESSION_IDLE_MINUTES=15
SESSION_HOURS=8
# Optional: only these PayPal emails may sign in (comma-separated). Empty = any PayPal sandbox account.
ALLOWED_PAYPAL_EMAILS=
# Log in with PayPal scopes: keep in line with the attributes ticked on the PayPal app
PAYPAL_LOGIN_SCOPES=openid profile email phone https://uri.paypal.com/services/paypalattributes

# Optional LLM for free-form AI Guard chat: anthropic | openai | none (default: built-in planner + PayPal tools)
LLM_PROVIDER=none
LLM_API_KEY=
# Optional overrides (model names change often; use a current model from your provider)
LLM_MODEL=
LLM_BASE_URL=

# Business name shown on PayPal checkout and invoices (the signed-in user's name comes from PayPal)
PAYMINUTE_BUSINESS_NAME=PayMinute
PAYMINUTE_CURRENCY=USD
# Default country for phone numbers typed without a +country code (US for US sandbox accounts, IN for India)
PAYMINUTE_PHONE_REGION=US
# Number/date format in the UI: en-IN for India (lakh/crore grouping), en-US default
PAYMINUTE_LOCALE=en-IN

# Public URL of the app: used for the PayPal login Return URL and checkout return/cancel URLs.
# Local dev with Vite: http://localhost:5173  ·  Local single server: http://localhost:8000  ·  Render: https://<your-app>.onrender.com
APP_BASE_URL=http://localhost:5173

# Customer payments with a risk score at or above this are held for review (0-1)
PAYMINUTE_HOLD_THRESHOLD=0.45
# How often (seconds) the background monitor refreshes pending payments
STATUS_POLL_SECONDS=60

PAYPAL_MCP=on
PAYPAL_SANDBOX_ACCESS_TOKEN=
ZAPIER_MCP_URL=
ZAPIER_MCP_API_KEY=
MCP_SERVERS=
KERNEL_API_KEY=
AG_STUDIO_LICENSE_KEY=
STUDIO_OPENAI_API_KEY=
STUDIO_AI_MODELS=
